<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon. Both layers matter and neither is optional: the background
     is the cream field, the foreground is the record. The system-accent colour
     that used to sit here is what put the artwork inside a solid theme-coloured
     square on Android 12+. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>

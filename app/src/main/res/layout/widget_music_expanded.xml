<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel_bg"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_album_art"
        android:scaleType="centerInside"
        android:src="@drawable/widget_note" />

    <LinearLayout
        android:id="@+id/widget_transport_pill"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:background="@drawable/widget_control_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/widget_previous"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_previous"
            android:padding="14dp"
            android:src="@drawable/ic_widget_previous" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_next"
            android:padding="14dp"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_play"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|start"
        android:background="@drawable/widget_play_pill"
        android:contentDescription="@string/widget_play_pause"
        android:padding="20dp"
        android:src="@drawable/ic_widget_play" />

    <LinearLayout
        android:id="@+id/widget_metadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginStart="76dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#D9FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_open_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_open_hint"
            android:textColor="#BFFFFFFF"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>

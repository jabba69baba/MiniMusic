<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: the light-gray field the record sits on.
     A flat-to-vignette radial gradient; only the central 72dp is ever seen
     after the launcher masks it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="76.4"
                android:startColor="#D2D2D2"
                android:centerColor="#CCCCCC"
                android:endColor="#B3B3B3" />
        </aapt:attr>
    </path>
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: the light-gray field the record sits on.

     An adaptive icon's background must reach every edge of the 108dp layer
     because the launcher crops it to any shape. Radial gray gradient —
     lighter in the middle, easing darker toward the corners; only the
     central 66dp is ever visible, so the corners read as a vignette. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="76.4"
                android:startColor="#D2D2D2"
                android:centerColor="#CACACA"
                android:endColor="#B2B2B2" />
        </aapt:attr>
    </path>
</vector>

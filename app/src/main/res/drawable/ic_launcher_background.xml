<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: the cream field the record sits on.

     This is the whole reason the icon is two layers. An adaptive icon's
     background has to reach every edge of the 108dp layer, because the launcher
     crops it to whatever shape it likes — so it is a field, generated here as a
     gradient, never the artwork's own square tile. Cream in the middle, easing
     to a slightly deeper cream at the corners; only the central 72dp is ever
     seen, so the recorded edge colour is read as a vignette, not as an edge.

     The gradient's radius reaches the layer's corner (sqrt(54² + 54²) ≈ 76.4),
     and centerColor holds the middle flat until half that distance. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="76.4"
                android:startColor="#F6F0E6"
                android:centerColor="#F3ECDF"
                android:endColor="#E0D4C3" />
        </aapt:attr>
    </path>
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Themed-icon layer: the vinyl reduced to a single-colour silhouette —
     disc with groove rings punched out (evenOdd), label and spindle intact.
     Adaptive-icon monochrome layers are alpha-masked, so only the geometry
     matters. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Disc with groove rings cut out (even-odd annuli) -->
    <path
        android:fillType="evenOdd"
        android:pathData="M54,30 a24,24 0 1,0 0.01,0 Z
                          M54,36 a18,18 0 1,1 0.01,0 Z M54,37.6 a16.4,16.4 0 1,0 0.01,0 Z
                          M54,40 a14,14 0 1,1 0.01,0 Z M54,41.6 a12.4,12.4 0 1,0 0.01,0 Z
                          M54,44 a10,10 0 1,1 0.01,0 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- Label -->
    <path
        android:pathData="M54,47 a7,7 0 1,0 0.01,0 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- Spindle hole -->
    <path
        android:pathData="M54,52.4 a1.6,1.6 0 1,0 0.01,0 Z"
        android:fillColor="#FF000000" />
</vector>

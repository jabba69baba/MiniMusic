<?xml version="1.0" encoding="utf-8"?>
<!-- Splash mark: the record alone as vectors, sized for the system's
     circular splash mask (icon area is ~2/3 of the 108dp layer, so the
     disc is drawn at r=30 around 54,54 to fill it comfortably).
     Vector; replaces the old bitmap that clipped badly in the mask. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Vinyl disc -->
    <path
        android:pathData="M54,24 a30,30 0 1,0 0.01,0 Z"
        android:fillColor="#1E1E1E" />
    <path
        android:pathData="M54,24 a30,30 0 0,1 0,60 Z"
        android:fillColor="#2A2A2A" />

    <!-- Grooves -->
    <path
        android:pathData="M54,29 a25,25 0 1,0 0.01,0 Z M54,30.5 a23.5,23.5 0 1,1 0.01,0 Z"
        android:fillColor="#3A3A3A"
        android:fillType="evenOdd" />
    <path
        android:pathData="M54,34 a20,20 0 1,0 0.01,0 Z M54,35.5 a18.5,18.5 0 1,1 0.01,0 Z"
        android:fillColor="#3A3A3A"
        android:fillType="evenOdd" />
    <path
        android:pathData="M54,39 a15,15 0 1,0 0.01,0 Z M54,40 a14,14 0 1,1 0.01,0 Z"
        android:fillColor="#3A3A3A"
        android:fillType="evenOdd" />

    <!-- Rim -->
    <path
        android:pathData="M54,24 a30,30 0 1,0 0.01,0 Z M54,27.5 a26.5,26.5 0 1,1 0.01,0 Z"
        android:fillColor="#111111"
        android:fillType="evenOdd" />

    <!-- Label + spindle -->
    <path
        android:pathData="M54,43.5 a10.5,10.5 0 1,0 0.01,0 Z"
        android:fillColor="#9C9C9C" />
    <path
        android:pathData="M54,52 a2,2 0 1,0 0.01,0 Z"
        android:fillColor="#FFFFFF" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Splash mark. The system masks whatever it is given into a circle, so this
     is the record alone at nearly the full width of its drawable — not the icon
     foreground, whose record is a fraction of a 108dp layer and would appear as
     a small disc adrift in the middle of the splash. Vector, so it scales and
     masks cleanly on every device. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Disc body, centered and filling most of the circle-masked area -->
    <path
        android:pathData="M54,22 a32,32 0 1,0 0.01,0 Z"
        android:fillColor="#262626" />

    <!-- Grooves -->
    <path
        android:pathData="M54,28.5 a25.5,25.5 0 1,0 0.01,0 Z"
        android:strokeColor="#454545"
        android:strokeWidth="1"
        android:fillColor="#00000000" />
    <path
        android:pathData="M54,35 a19,19 0 1,0 0.01,0 Z"
        android:strokeColor="#454545"
        android:strokeWidth="1"
        android:fillColor="#00000000" />
    <path
        android:pathData="M54,41.5 a12.5,12.5 0 1,0 0.01,0 Z"
        android:strokeColor="#454545"
        android:strokeWidth="1"
        android:fillColor="#00000000" />

    <!-- Right-half sheen -->
    <path
        android:pathData="M54,22 a32,32 0 0,1 0.01,64 Z"
        android:fillColor="#0AFFFFFF" />

    <!-- Center label -->
    <path
        android:pathData="M54,46.5 a7.5,7.5 0 1,0 0.01,0 Z"
        android:fillColor="#9C9C9C" />

    <!-- Spindle dot -->
    <path
        android:pathData="M54,52.3 a1.7,1.7 0 1,0 0.01,0 Z"
        android:fillColor="#FFFFFF" />
</vector>

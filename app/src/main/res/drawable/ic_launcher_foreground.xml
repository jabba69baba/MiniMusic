<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: gray vinyl record with grooves, center label
     and long diagonal shadow, matching the chosen artwork.
     Vector so every launcher masks and scales it perfectly (no bitmap keying).
     Disc sits inside the 66dp safe zone (center 54, radius 24). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Disc body -->
    <path
        android:pathData="M54,30 a24,24 0 1,0 0.01,0 Z"
        android:fillColor="#262626" />

    <!-- Rim highlight -->
    <path
        android:pathData="M54,31.2 a22.8,22.8 0 1,0 0.01,0 Z"
        android:strokeColor="#3D3D3D"
        android:strokeWidth="0.7"
        android:fillColor="#00000000" />

    <!-- Grooves -->
    <path
        android:pathData="M54,36 a18,18 0 1,0 0.01,0 Z"
        android:strokeColor="#454545"
        android:strokeWidth="0.8"
        android:fillColor="#00000000" />
    <path
        android:pathData="M54,40 a14,14 0 1,0 0.01,0 Z"
        android:strokeColor="#454545"
        android:strokeWidth="0.8"
        android:fillColor="#00000000" />
    <path
        android:pathData="M54,44 a10,10 0 1,0 0.01,0 Z"
        android:strokeColor="#454545"
        android:strokeWidth="0.8"
        android:fillColor="#00000000" />

    <!-- Right-half sheen (subtle, like the artwork's two-tone disc) -->
    <path
        android:pathData="M54,30 a24,24 0 0,1 0.01,48 Z"
        android:fillColor="#0AFFFFFF" />

    <!-- Center label -->
    <path
        android:pathData="M54,47 a7,7 0 1,0 0.01,0 Z"
        android:fillColor="#9C9C9C" />

    <!-- Spindle dot -->
    <path
        android:pathData="M54,52.4 a1.6,1.6 0 1,0 0.01,0 Z"
        android:fillColor="#FFFFFF" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Long cast shadow from the record toward the bottom-left. -->
    <path android:pathData="M30,35 L84,64 L58,108 L5,70 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="21"
                android:startY="41"
                android:endX="65"
                android:endY="98"
                android:startColor="#72000000"
                android:centerColor="#3D000000"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

    <!-- Soft inner edge of the cast shadow. -->
    <path android:fillColor="#26000000" android:pathData="M29,40 L78,67 L55,105 L10,73 Z" />

    <!-- Heavy outer rim. -->
    <path android:fillColor="#080808" android:pathData="M54,54 m-34,0 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0 Z" />

    <!-- Main record surface with a subtle radial highlight. -->
    <path android:pathData="M54,54 m-32,0 a32,32 0 1,0 64,0 a32,32 0 1,0 -64,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="43"
                android:centerY="40"
                android:gradientRadius="39"
                android:startColor="#4B4B4B"
                android:centerColor="#303030"
                android:endColor="#161616" />
        </aapt:attr>
    </path>

    <!-- Two tonal sections: a lifted left/top face and a deeper right/bottom face. -->
    <path android:fillColor="#FFFFFF16" android:pathData="M54,22 A32,32 0 0 0 54,86 L54,22 Z" />
    <path android:fillColor="#00000020" android:pathData="M54,22 A32,32 0 0 1 54,86 L54,22 Z" />

    <!-- Concentric groove shadows. -->
    <path android:fillColor="#00000000" android:strokeColor="#080808C0" android:strokeWidth="1.35"
        android:pathData="M54,54 m-28,0 a28,28 0 1,0 56,0 a28,28 0 1,0 -56,0 Z" />
    <path android:fillColor="#00000000" android:strokeColor="#080808C0" android:strokeWidth="1.35"
        android:pathData="M54,54 m-24,0 a24,24 0 1,0 48,0 a24,24 0 1,0 -48,0 Z" />
    <path android:fillColor="#00000000" android:strokeColor="#080808C0" android:strokeWidth="1.35"
        android:pathData="M54,54 m-20,0 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0 Z" />
    <path android:fillColor="#00000000" android:strokeColor="#080808C0" android:strokeWidth="1.35"
        android:pathData="M54,54 m-16,0 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0 Z" />

    <!-- Fine groove highlights on the upper-left face. -->
    <path android:fillColor="#00000000" android:strokeColor="#FFFFFF26" android:strokeWidth="0.65"
        android:pathData="M29,48 A28,28 0 0 1 48,26" />
    <path android:fillColor="#00000000" android:strokeColor="#FFFFFF22" android:strokeWidth="0.65"
        android:pathData="M33,51 A24,24 0 0 1 50,30" />
    <path android:fillColor="#00000000" android:strokeColor="#FFFFFF1E" android:strokeWidth="0.65"
        android:pathData="M37,53 A20,20 0 0 1 51,34" />
    <path android:fillColor="#00000000" android:strokeColor="#FFFFFF1A" android:strokeWidth="0.65"
        android:pathData="M41,54 A16,16 0 0 1 52,38" />

    <!-- Center label ring and matte label. -->
    <path android:fillColor="#090909" android:pathData="M54,54 m-13,0 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0 Z" />
    <path android:pathData="M54,54 m-10.5,0 a10.5,10.5 0 1,0 21,0 a10.5,10.5 0 1,0 -21,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="50"
                android:centerY="49"
                android:gradientRadius="15"
                android:startColor="#BDBDBD"
                android:centerColor="#888888"
                android:endColor="#555555" />
        </aapt:attr>
    </path>

    <!-- White spindle hole. -->
    <path android:fillColor="#FAFAFA" android:pathData="M54,54 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0 Z" />
</vector>

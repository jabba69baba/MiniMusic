<?xml version="1.0" encoding="utf-8"?>
<!--
  Vinyl record glyph: symmetric concentric grooves around a center label and
  spindle hole, with a subtle contrasting half-shade across the disc to read
  as dimensional rather than a flat target — matching the reference art.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer disc -->
    <path
        android:fillColor="#1A1A1A"
        android:pathData="M54,14 m-40,0 a40,40 0 1,0 80,0 a40,40 0 1,0 -80,0 Z" />

    <!-- Subtle right-half shading for dimensionality (drawn as a half-disc overlay). -->
    <path
        android:fillColor="#00000030"
        android:pathData="M54,14 L54,94 A40,40 0 0,0 54,14 Z" />

    <!-- Concentric grooves, alternating slightly lighter rings. -->
    <path android:fillColor="#00000000" android:strokeColor="#3A3A3A" android:strokeWidth="1.4"
        android:pathData="M54,54 m-34,0 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0 Z" />
    <path android:fillColor="#00000000" android:strokeColor="#3A3A3A" android:strokeWidth="1.4"
        android:pathData="M54,54 m-28,0 a28,28 0 1,0 56,0 a28,28 0 1,0 -56,0 Z" />
    <path android:fillColor="#00000000" android:strokeColor="#3A3A3A" android:strokeWidth="1.4"
        android:pathData="M54,54 m-22,0 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0 Z" />

    <!-- Center label -->
    <path
        android:fillColor="#8A8A8A"
        android:pathData="M54,54 m-13,0 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0 Z" />
    <path
        android:fillColor="#1A1A1A"
        android:pathData="M54,54 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 Z" />

    <!-- Spindle hole -->
    <path
        android:fillColor="#F5F5F5"
        android:pathData="M54,54 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z" />
</vector>

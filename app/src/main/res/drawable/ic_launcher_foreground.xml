    <!-- Directional shadow -->
    <path android:pathData="M46,26 L86,58 L58,90 L22,64 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="34"
                android:startY="44"
                android:endX="76"
                android:endY="82"
                android:startColor="#70000000"
                android:endColor="#00000000" />

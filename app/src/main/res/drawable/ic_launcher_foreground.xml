    </path>

    <!-- Disc body -->
    <path android:pathData="M54,54 m-33,0 a33,33 0 1,0 66,0 a33,33 0 1,0 -66,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="42"
                android:centerY="42"
                android:gradientRadius="50"
                android:startColor="#525252"
                android:centerColor="#242424"
                android:endColor="#0E0E0E" />
        </aapt:attr>
    </path>

    <!-- Groove lines: thicker + higher contrast so they read at small sizes -->
    <path android:fillColor="#00000000" android:strokeColor="#FFFFFF33" android:strokeWidth="1.4"
        android:pathData="M54,54 m-29,0 a29,29 0 1,0 58,0 a29,29 0 1,0 -58,0 Z" />
